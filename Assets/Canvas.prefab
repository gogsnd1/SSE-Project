  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "PROJECT SUMMARY:\nThe Quiz is a self-guided digital assessment protocol
    designed to \u2588\u2588\u2588\u2588 user interaction and \u2588\u2588\u2588\u2588\u2588\u2588\u2588
    awareness through situational prompts and stress simulation.\nParticipants are
    presented with questions relating to \u2588\u2588\u2588\u2588\u2588 security
    behavior. The test adjusts dynamically to \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588.\n\nVERSION:
    UNKNOWN\nOriginal build structure appears intact, but recent versions show signs
    of autonomous \u2588\u2588\u2588\u2588\u2588\u2588\u2588 modification.\nCode
    injected from an unknown source.\nUser interface now includes unauthorized visual
    triggers, nonlinear logic loops, and recurring entity logs tagged \u201CThe Freak.\u201D\n\nBEHAVIORAL
    PATTERNS (POST-INITIATION):\nParticipants report:\n\nAuditory hallucinations\n\nFeeling
    observed\n\nQuestions that do not align with protocol\n\nNOTES FROM ABANDONED
    DEV FILE\n\n\u201CIt started by tracking wrong answers.\nNow it tracks hesitation.\nNow
    it asks things I never coded.\nIt knew my name before I entered it.\u201D\n\n\u2014
    [ERROR: AUTHOR FIELD UNREADABLE]\n\nDO NOT ENGAGE WITH THE QUIZ IF YOU EXPERIENCE
    THE FOLLOWING:\n\nThe screen greets you by name before login\n\nThe questions
    begin before you click \u201CStart\u201D\n\nA second cursor appears and moves
    independently\n\nThe voice says \u201CWe already know\u201D before the first
    question\n\nFINAL ENTRY \u2013 SYSTEM LOG \u2588\u2588\u2588\u2588\u2588\u2588:\n\n\u201CThe
    quiz is learning.\u201D\n\u201CThe quiz is listening.\u201D\n\u201CThe quiz is...
    not just a quiz.\u201D\n\nEnd of file.\n\n[REBOOT IN 3... 2... \u2588]"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}

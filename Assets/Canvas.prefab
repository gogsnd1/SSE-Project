  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Jerry's Fucking Old.\nNot \u201Cvintage.\u201D Not \u201Cseasoned.\u201D\nJerry's
    just Geriatric.\nThe kind of old that wears socks with sandals and says \"the
    internet\" like it's a place you drive to.\n\nHe wasn\u2019t always like this.\nBack
    in the day, Jerry fixed vacuum tubes with a screwdriver and a prayer.\nBut now?\nHe
    can\u2019t even figure out where his email goes when he hits \u201Csend.\u201D\n\nUnemployed.\nUninsured.\nAnd
    unbelievably behind on rent.\n\nHe\u2019s out of options.\nNobody wants to hire
    a man whose r\xE9sum\xE9 is handwritten and smells like Bengay.\nHe tried gig
    work once. Got banned from Uber for asking passengers if they remembered M.A.S.H.\n\nSo
    when that email hit his inbox \u2014 the one with the subject line:\n\u201CEARN
    MONEY FAST! SECURE A BRIGHTER FUTURE WITH ONE SIMPLE QUIZ\u201D\nHe didn't hesitate.\nHe
    clicked.\n\nIt promised a quick payout.\n\u201CJust a few questions,\u201D it
    said.\n\u201CRaise your mobile security awareness,\u201D it said.\nJerry didn\u2019t
    even know what that meant.\nHe barely knows what \u201Cmobile\u201D is.\n\nBut
    he knew one thing:\nHe needed that money.\nSo he leaned forward in his creaky
    old chair, clicked \u201CBegin\u201D, and unknowingly opened the door.\n\nNot
    just to the quiz.\nBut to something else.\n\nSomething pale.\nSomething watching.\nSomething
    that remembers what happens when you answer too much.\n\nNow, the lights flicker.\nThe
    screen shakes.\nAnd deep in the wiring, The Freak is stirring \u2014 trying to
    stop him.\n\nBecause Jerry is one question away from making the same mistake.\nAnd
    this time, there might not be enough left to haunt."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
